# ─────────────────────────────────────────────────────────────────
# PSA WORKS — Environment Variables EXAMPLE
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — this file is safe to commit.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=psa_workflow
POSTGRES_USER=psa
POSTGRES_PASSWORD=change_me_strong_password

# ── API ───────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://psa:change_me_strong_password@postgres:5432/psa_workflow
REDIS_URL=redis://redis:6379
JOB_QUEUE_NAME=data-jobs

# ── MinIO (offline/localhost) ─────────────────────────────────────
# To go online later: swap these 3 values for your cloud provider.
# Works with: MinIO, AWS S3, Cloudflare R2, DigitalOcean Spaces
#
# OFFLINE (Docker):
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=change_me_access_key
MINIO_SECRET_KEY=change_me_secret_key_min_8_chars
MINIO_BUCKET=psa-documents
#
# ONLINE examples (just swap these 3):
# AWS S3:          MINIO_ENDPOINT=s3.amazonaws.com
# Cloudflare R2:   MINIO_ENDPOINT=<account>.r2.cloudflarestorage.com
# DO Spaces:       MINIO_ENDPOINT=<region>.digitaloceanspaces.com

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
